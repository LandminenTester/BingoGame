generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum TemplateVisibility {
  private
  public
  unlisted
  predefined
}

enum LobbyStatus {
  draft
  open
  running
  paused
  completed
  cancelled
}

enum GameMode {
  individual
  streamer_controlled
}

enum WinningCondition {
  first_line
  full_card
}

enum ParticipantRole {
  host
  player
}

model User {
  id String @id @default(cuid())
  twitchUserId String @unique
  displayName String
  loginName String
  profileImageUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  templates BingoTemplate[]
  hostedLobbies Lobby[] @relation("LobbyHost")
  participations LobbyParticipant[]
  apiKeys ApiKey[]
  auditEvents AuditEvent[]
  sessions UserSession[]
}

model UserSession {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model BingoTemplate {
  id String @id @default(cuid())
  authorId String?
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  name String
  description String? @db.VarChar(1000)
  game String? @db.VarChar(100)
  category String? @db.VarChar(100)
  language String @default("de") @db.VarChar(12)
  visibility TemplateVisibility @default(private)
  tags String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fields BingoTemplateField[]
  lobbies Lobby[]
}

model BingoTemplateField {
  id String @id @default(cuid())
  templateId String
  template BingoTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  position Int
  label String @db.VarChar(160)
  createdAt DateTime @default(now())
  cardFields PlayerCardField[]
  @@unique([templateId, position])
}

model Lobby {
  id String @id @default(cuid())
  code String @unique @db.Char(6)
  name String @db.VarChar(100)
  hostId String
  host User @relation("LobbyHost", fields: [hostId], references: [id])
  templateId String
  template BingoTemplate @relation(fields: [templateId], references: [id])
  status LobbyStatus @default(draft)
  gameMode GameMode
  winningCondition WinningCondition
  maxParticipants Int @default(100)
  passwordHash String?
  allowLateJoin Boolean @default(true)
  lateJoinEligible Boolean @default(true)
  startedAt DateTime?
  endedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  participants LobbyParticipant[]
  events LobbyEvent[]
  results BingoResult[]
}

model LobbyParticipant {
  id String @id @default(cuid())
  lobbyId String
  userId String
  role ParticipantRole @default(player)
  joinedAt DateTime @default(now())
  leftAt DateTime?
  lobby Lobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
  card PlayerCard?
  result BingoResult?
  @@unique([lobbyId, userId])
}

model PlayerCard {
  id String @id @default(cuid())
  participantId String @unique
  participant LobbyParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  fields PlayerCardField[]
  createdAt DateTime @default(now())
}

model PlayerCardField {
  id String @id @default(cuid())
  cardId String
  templateFieldId String
  position Int
  completedAt DateTime?
  confirmedByHost Boolean @default(false)
  card PlayerCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  templateField BingoTemplateField @relation(fields: [templateFieldId], references: [id], onDelete: Restrict)
  @@unique([cardId, position])
  @@unique([cardId, templateFieldId])
}

model LobbyEvent {
  id String @id @default(cuid())
  lobbyId String
  templateFieldId String
  completed Boolean
  createdAt DateTime @default(now())
  lobby Lobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  @@index([lobbyId, templateFieldId])
}

model BingoResult {
  id String @id @default(cuid())
  lobbyId String
  participantId String @unique
  placement Int
  completedAt DateTime
  completedFields Int
  isWinner Boolean @default(false)
  validated Boolean @default(true)
  lobby Lobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  participant LobbyParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  @@unique([lobbyId, placement])
}

model ApiKey {
  id String @id @default(cuid())
  userId String
  name String @db.VarChar(100)
  keyHash String @unique
  scopes String[]
  expiresAt DateTime?
  lastUsedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id String @id @default(cuid())
  userId String?
  action String @db.VarChar(100)
  targetType String @db.VarChar(50)
  targetId String?
  metadata Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([targetType, targetId])
}
