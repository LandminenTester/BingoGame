{
  "name": "@twitch-bingo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @twitch-bingo/contracts build",
    "prebuild": "pnpm --filter @twitch-bingo/contracts build",
    "prelint": "pnpm --filter @twitch-bingo/contracts build",
    "pretest": "pnpm --filter @twitch-bingo/contracts build",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@prisma/client": "^6.19.3",
    "@twitch-bingo/contracts": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.5.0",
    "zod": "^4.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
