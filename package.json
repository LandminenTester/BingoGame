{
  "name": "twitch-bingo",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm --filter @twitch-bingo/contracts build && pnpm --filter @twitch-bingo/api build && pnpm --filter @twitch-bingo/web build",
    "dev": "pnpm --parallel --filter @twitch-bingo/api --filter @twitch-bingo/web dev",
    "lint": "pnpm --parallel --filter @twitch-bingo/api --filter @twitch-bingo/web lint",
    "test": "pnpm --recursive test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
