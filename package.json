{
  "name": "bingo-buddy",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm --filter @bingo-buddy/contracts build && pnpm --filter @bingo-buddy/api build && pnpm --filter @bingo-buddy/web build",
    "dev": "pnpm --parallel --filter @bingo-buddy/api --filter @bingo-buddy/web dev",
    "lint": "pnpm --parallel --filter @bingo-buddy/api --filter @bingo-buddy/web lint",
    "test": "pnpm --recursive test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
